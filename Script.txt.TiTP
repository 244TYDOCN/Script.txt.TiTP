-- 3. ฟังก์ชันสร้างรายการ Multi-Point Teleport (÷) + บินย้อนกลับ
---------------------------------------------------------
local function createMultiTeleportRow()
	local pointList = {}
	local isTeleporting = false
	local currentTween = nil
	local tpTask = nil

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 40)
	row.BackgroundColor3 = Color3.fromRGB(45, 40, 50)
	row.BorderSizePixel = 0
	row.Parent = scrollFrame

	local rowCorner = Instance.new("UICorner")
	rowCorner.CornerRadius = UDim.new(0, 6)
	rowCorner.Parent = row

	-- ปุ่มเริ่มบิน
	local startBtn = Instance.new("TextButton")
	startBtn.Size = UDim2.new(0, 80, 0, 28)
	startBtn.Position = UDim2.new(0, 6, 0, 6)
	startBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	startBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
	startBtn.Text = "เริ่มบิน (0)"
	startBtn.Font = Enum.Font.SourceSansBold
	startBtn.TextSize = 11
	startBtn.Parent = row

	local startCorner = Instance.new("UICorner")
	startCorner.CornerRadius = UDim.new(0, 4)
	startCorner.Parent = startBtn

	-- ปุ่มวางจุด
	local setBtn = Instance.new("TextButton")
	setBtn.Size = UDim2.new(0, 75, 0, 28)
	setBtn.Position = UDim2.new(0, 90, 0, 6)
	setBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
	setBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	setBtn.Text = "วางจุด"
	setBtn.Font = Enum.Font.SourceSansBold
	setBtn.TextSize = 12
	setBtn.Parent = row

	local setCorner = Instance.new("UICorner")
	setCorner.CornerRadius = UDim.new(0, 4)
	setCorner.Parent = setBtn

	-- ปุ่มลบจุดล่าสุด (-)
	local removePointBtn = Instance.new("TextButton")
	removePointBtn.Size = UDim2.new(0, 28, 0, 28)
	removePointBtn.Position = UDim2.new(0, 169, 0, 6)
	removePointBtn.BackgroundColor3 = Color3.fromRGB(210, 100, 0)
	removePointBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	removePointBtn.Text = "-"
	removePointBtn.Font = Enum.Font.SourceSansBold
	removePointBtn.TextSize = 18
	removePointBtn.Parent = row

	local removeCorner = Instance.new("UICorner")
	removeCorner.CornerRadius = UDim.new(0, 4)
	removeCorner.Parent = removePointBtn

	-- ปุ่มคัดลอกโค้ด
	local copyBtn = Instance.new("TextButton")
	copyBtn.Size = UDim2.new(0, 85, 0, 28)
	copyBtn.Position = UDim2.new(0, 201, 0, 6)
	copyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	copyBtn.Text = "คัดลอกโค้ด"
	copyBtn.Font = Enum.Font.SourceSansBold
	copyBtn.TextSize = 11
	copyBtn.Parent = row

	local copyCorner = Instance.new("UICorner")
	copyCorner.CornerRadius = UDim.new(0, 4)
	copyCorner.Parent = copyBtn

	-- ปุ่มลบแถว (X)
	local delBtn = Instance.new("TextButton")
	delBtn.Size = UDim2.new(0, 28, 0, 28)
	delBtn.Position = UDim2.new(1, -34, 0, 6)
	delBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	delBtn.Text = "X"
	delBtn.Font = Enum.Font.SourceSansBold
	delBtn.TextSize = 13
	delBtn.Parent = row

	local delCorner = Instance.new("UICorner")
	delCorner.CornerRadius = UDim.new(0, 4)
	delCorner.Parent = delBtn

	-- 1. กดวางจุด
	setBtn.MouseButton1Click:Connect(function()
		local root = getTargetRoot()
		if root then
			table.insert(pointList, root.CFrame)
			local count = #pointList
			
			setBtn.Text = "วางแล้ว " .. count
			if not isTeleporting then
				startBtn.Text = "เริ่มบิน (" .. count .. ")"
				startBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
			end
			copyBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
		end
	end)

	-- 2. กดลบจุดล่าสุด
	removePointBtn.MouseButton1Click:Connect(function()
		if #pointList > 0 then
			table.remove(pointList, #pointList)
			local count = #pointList
			
			if count > 0 then
				setBtn.Text = "วางแล้ว " .. count
				if not isTeleporting then
					startBtn.Text = "เริ่มบิน (" .. count .. ")"
				end
			else
				setBtn.Text = "วางจุด"
				startBtn.Text = "เริ่มบิน (0)"
				startBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
				copyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
			end
		end
	end)

	-- 3. กดเริ่มบิน (คำนวณเส้นทางและรองรับโหมดบินย้อนกลับ)
	startBtn.MouseButton1Click:Connect(function()
		if #pointList == 0 then return end

		if isTeleporting then
			isTeleporting = false
			if currentTween then currentTween:Cancel() end
			if tpTask then task.cancel(tpTask) end
			startBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
			startBtn.Text = "เริ่มบิน (" .. #pointList .. ")"
			return
		end

		isTeleporting = true
		startBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)

		tpTask = task.spawn(function()
			-- สร้างรายการบินไป (1 -> N)
			local flightPath = {}
			for _, cf in ipairs(pointList) do
				table.insert(flightPath, cf)
			end

			-- ถ้าเปิดโหมดบินย้อนกลับ ให้เพิ่มเส้นทางขากลับ (N-1 -> 1)
			if globalPingPong and #pointList > 1 then
				for i = #pointList - 1, 1, -1 do
					table.insert(flightPath, pointList[i])
				end
			end

			local totalSteps = #flightPath
			for idx, cf in ipairs(flightPath) do
				if not isTeleporting then break end
				startBtn.Text = "จุดที่ " .. idx .. "/" .. totalSteps
				
				local tween, duration = flyTo(cf)
				if tween then
					currentTween = tween
					task.wait(duration)
				end
			end

			isTeleporting = false
			startBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
			startBtn.Text = "สำเร็จแล้ว! (" .. #pointList .. ")"
			task.wait(1.5)
			if not isTeleporting then
				startBtn.Text = "เริ่มบิน (" .. #pointList .. ")"
			end
		end)
	end)

	-- 4. คัดลอก Code
	copyBtn.MouseButton1Click:Connect(function()
		if #pointList > 0 and setclipboard then
			local scriptText = string.format("local TweenService = game:GetService('TweenService')\nlocal flySpeed = %d\nlocal isPingPong = %s\nlocal points = {\n", flySpeed, tostring(globalPingPong))
			for _, cf in ipairs(pointList) do
				scriptText = scriptText .. string.format("    CFrame.new(%s),\n", table.concat({cf:GetComponents()}, ", "))
			end
			scriptText = scriptText .. [[}

local char = game:GetService("Players").LocalPlayer.Character
local root = char and (char:FindFirstChildOfClass("Humanoid").SeatPart and char:FindFirstChildOfClass("Humanoid").SeatPart.Parent.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))

if root then
    local flightPath = {}
    for _, cf in ipairs(points) do table.insert(flightPath, cf) end
    if isPingPong and #points > 1 then
        for i = #points - 1, 1, -1 do table.insert(flightPath, points[i]) end
    end

    for _, cf in ipairs(flightPath) do
        local dist = (root.Position - cf.Position).Magnitude
        local dur = dist / flySpeed
        local tween = TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = cf})
        tween:Play()
        task.wait(dur)
    end
end]]
			
			setclipboard(scriptText)
			copyBtn.Text = "คัดลอกแล้ว!"
			task.wait(1)
			copyBtn.Text = "คัดลอกโค้ด"
		end
	end)

	delBtn.MouseButton1Click:Connect(function()
		isTeleporting = false
		if currentTween then currentTween:Cancel() end
		if tpTask then task.cancel(tpTask) end
		row:Destroy()
	end)
end

---------------------------------------------------------
-- 4. เชื่อมต่อปุ่ม + / ÷ และสร้างรายการแรก
---------------------------------------------------------
addButton.MouseButton1Click:Connect(function()
	createSingleTeleportRow()
end)

multiAddButton.MouseButton1Click:Connect(function()
	createMultiTeleportRow()
end)

-- สร้างจุดวาร์ปปกติเริ่มต้น 1 จุด
createSingleTeleportRow()
