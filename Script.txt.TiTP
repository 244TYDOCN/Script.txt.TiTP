-- 2. ฟังก์ชันสร้างรายการเทเลพอร์ตแบบปกติ (+)
---------------------------------------------------------
local locationCounter = 0

local function createSingleTeleportRow()
	locationCounter = locationCounter + 1
	local rowId = locationCounter
	local savedCFrame = nil
	local generatedScript = ""

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 40)
	row.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	row.BorderSizePixel = 0
	row.Parent = scrollFrame

	local rowCorner = Instance.new("UICorner")
	rowCorner.CornerRadius = UDim.new(0, 6)
	rowCorner.Parent = row

	local tpBtn = Instance.new("TextButton")
	tpBtn.Size = UDim2.new(0, 85, 0, 28)
	tpBtn.Position = UDim2.new(0, 6, 0, 6)
	tpBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	tpBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
	tpBtn.Text = "บินไป " .. rowId
	tpBtn.Font = Enum.Font.SourceSansBold
	tpBtn.TextSize = 13
	tpBtn.Parent = row

	local tpCorner = Instance.new("UICorner")
	tpCorner.CornerRadius = UDim.new(0, 4)
	tpCorner.Parent = tpBtn

	local setBtn = Instance.new("TextButton")
	setBtn.Size = UDim2.new(0, 70, 0, 28)
	setBtn.Position = UDim2.new(0, 96, 0, 6)
	setBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
	setBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	setBtn.Text = "วางจุด"
	setBtn.Font = Enum.Font.SourceSansBold
	setBtn.TextSize = 13
	setBtn.Parent = row

	local setCorner = Instance.new("UICorner")
	setCorner.CornerRadius = UDim.new(0, 4)
	setCorner.Parent = setBtn

	local copyBtn = Instance.new("TextButton")
	copyBtn.Size = UDim2.new(0, 85, 0, 28)
	copyBtn.Position = UDim2.new(0, 171, 0, 6)
	copyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	copyBtn.Text = "คัดลอกโค้ด"
	copyBtn.Font = Enum.Font.SourceSansBold
	copyBtn.TextSize = 12
	copyBtn.Parent = row

	local copyCorner = Instance.new("UICorner")
	copyCorner.CornerRadius = UDim.new(0, 4)
	copyCorner.Parent = copyBtn

	local delBtn = Instance.new("TextButton")
	delBtn.Size = UDim2.new(0, 28, 0, 28)
	delBtn.Position = UDim2.new(1, -34, 0, 6)
	delBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	delBtn.Text = "X"
	delBtn.Font = Enum.Font.SourceSansBold
	delBtn.TextSize = 13
	delBtn.Parent = row

	local delCorner = Instance.new("UICorner")
	delCorner.CornerRadius = UDim.new(0, 4)
	delCorner.Parent = delBtn

	setBtn.MouseButton1Click:Connect(function()
		local root = getTargetRoot()
		if root then
			savedCFrame = root.CFrame
			local cfComponents = {savedCFrame:GetComponents()}
			generatedScript = string.format([[
local TweenService = game:GetService("TweenService")
local targetCF = CFrame.new(%s)
local char = game:GetService("Players").LocalPlayer.Character
local root = char and (char:FindFirstChildOfClass("Humanoid").SeatPart and char:FindFirstChildOfClass("Humanoid").SeatPart.Parent.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
if root then
    local dist = (root.Position - targetCF.Position).Magnitude
    TweenService:Create(root, TweenInfo.new(dist/%d, Enum.EasingStyle.Linear), {CFrame = targetCF}):Play()
end]], table.concat(cfComponents, ", "), flySpeed)

			tpBtn.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
			tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			copyBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
			
			setBtn.Text = "วางแล้ว"
			task.wait(0.8)
			setBtn.Text = "วางจุดใหม่"
		end
	end)

	tpBtn.MouseButton1Click:Connect(function()
		if savedCFrame then
			flyTo(savedCFrame)
		end
	end)

	copyBtn.MouseButton1Click:Connect(function()
		if generatedScript ~= "" and setclipboard then
			setclipboard(generatedScript)
			copyBtn.Text = "คัดลอกแล้ว!"
			task.wait(1)
			copyBtn.Text = "คัดลอกโค้ด"
		end
	end)

	delBtn.MouseButton1Click:Connect(function()
		row:Destroy()
	end)
end

